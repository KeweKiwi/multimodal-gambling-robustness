    "maximum_threshold": 0.95,
    "step": 0.01
  },
  "primary_metric": "positive_class_f1",
  "secondary_metrics": [
    "accuracy",
    "precision",
    "recall",
    "roc_auc",
    "pr_auc",
    "brier_score",
    "confusion_matrix"
  ],
  "models": [
    "text_only_mlp",
    "image_only_mlp",
    "average_logit_fusion",
    "learnable_weighted_logit_fusion",
    "raw_concatenation_fusion",
    "projection_fusion",
    "contrastive_similarity_fusion"
