{
  "experiment_version": "final_v2",
  "training_data": "clean_train_embeddings_only",
  "validation_data": "clean_validation_embeddings",
  "test_data": "clean_and_frozen_perturbed_test_sets",
  "encoder_status": "frozen",
  "text_encoder": "intfloat/multilingual-e5-large",
  "image_encoder": "google/siglip2-so400m-patch14-384",
  "text_embedding_dimension": 1024,
  "image_embedding_dimension": 1152,
  "random_seeds": [
    42,
    52,
    62,
    72,
    82
